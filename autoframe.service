# systemd user service. Install with:
#   cp autoframe.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now autoframe
[Unit]
Description=Auto-framing virtual camera (PipeWire)
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
ExecStart=%h/.local/bin/autoframe
# Exits non-zero if PipeWire goes away or no camera is available yet; just try again.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
